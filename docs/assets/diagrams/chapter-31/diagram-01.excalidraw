    {
      "id": "note",
      "type": "text",
      "x": 40,
      "y": 720,
      "width": 742.0341796875,
      "height": 90,
      "text": "Same Entra tenant. The dedicated Business Central app receives workspace Contributor.\nConfirm prerelease rollout/version; monitor source runs and Fabric processing independently.",
