      "versionNonce": 2043901767,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791302096440,
      "link": null,
      "locked": false,
      "text": "Check STALE_AFTER using SHOW STREAMS or DESCRIBE STREAM.\nRetention includes DATA_RETENTION_TIME_IN_DAYS and MAX_DATA_EXTENSION_TIME_IN_DAYS.\nDo not treat 14 days as a universal retention period.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Check STALE_AFTER using SHOW STREAMS or DESCRIBE STREAM.\nRetention includes DATA_RETENTION_TIME_IN_DAYS and MAX_DATA_EXTENSION_TIME_IN_DAYS.\nDo not treat 14 days as a universal retention period.",
      "autoResize": true,
      "lineHeight": 1.15
