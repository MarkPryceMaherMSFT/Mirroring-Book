      "isDeleted": false,
      "boundElements": null,
      "updated": 1791302179416,
      "link": null,
      "locked": false,
      "text": "List rows are replicated into Delta tables. Document Library files are read in place through OneLake shortcuts, not copied.\nA document shortcut does not make every file a SQL or Direct Lake table.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List rows are replicated into Delta tables. Document Library files are read in place through OneLake shortcuts, not copied.\nA document shortcut does not make every file a SQL or Direct Lake table.",
      "autoResize": true,
      "lineHeight": 1.15
    },
