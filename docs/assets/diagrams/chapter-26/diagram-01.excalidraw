      "boundElements": null,
      "updated": 1791302098301,
      "link": null,
      "locked": false,
      "text": "Only namespace, table, and schema metadata is synced. Iceberg data remains in source storage and is read through shortcuts.\nDremio vends short-lived storage credentials; catalog connection authentication is separate.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only namespace, table, and schema metadata is synced. Iceberg data remains in source storage and is read through shortcuts.\nDremio vends short-lived storage credentials; catalog connection authentication is separate.",
      "autoResize": true,
      "lineHeight": 1.15
    },
