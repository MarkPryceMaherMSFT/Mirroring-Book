      "versionNonce": 234479142,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794268800000,
      "link": null,
      "locked": false,
      "text": "Follow the data first. If OneLake is stale, investigate replication. If OneLake is current but SQL is stale, investigate metadata\nsync. The workspace switch affects subsequently created endpoints; it does not upgrade existing ones, and an on-demand REST\nrefresh does not require v2.",
      "originalText": "Follow the data first. If OneLake is stale, investigate replication. If OneLake is current but SQL is stale, investigate metadata sync. The workspace switch affects subsequently created endpoints; it does not upgrade existing ones, and an on-demand REST refresh does not require v2.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.4,
      "autoResize": false
    }
