      "boundElements": null,
      "updated": 1786176000770,
      "link": null,
      "locked": false,
      "text": "No storage or pipeline is created. All three access paths read the same Log Analytics Delta Parquet storage through OneLake shortcuts. Latency in Fabric matches Azure Monitor latency, typically minutes.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No storage or pipeline is created. All three access paths read the same Log Analytics Delta Parquet storage through OneLake shortcuts. Latency in Fabric matches Azure Monitor latency, typically minutes.",
      "autoResize": true,
      "lineHeight": 1.15
    },
