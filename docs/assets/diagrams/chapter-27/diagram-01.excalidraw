      "boundElements": null,
      "updated": 1786176002120,
      "link": null,
      "locked": false,
      "text": "Only database, table, and schema metadata is synced. Underlying Iceberg table data stays in Amazon S3 and is read through OneLake shortcuts. The AWS Glue endpoint and S3 storage must be reachable over the public internet.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only database, table, and schema metadata is synced. Underlying Iceberg table data stays in Amazon S3 and is read through OneLake shortcuts. The AWS Glue endpoint and S3 storage must be reachable over the public internet.",
      "autoResize": true,
      "lineHeight": 1.15
    },
